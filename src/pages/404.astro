---
// Shown by Cloudflare Pages for any address that doesn't exist.
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="section">
    <div class="wrap narrow stack" style="text-align:center">
      <p class="eyebrow">404</p>
      <h1>We couldn’t find that page.</h1>
      <p class="lead muted">It may have moved when we redesigned the site.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn" href="/">Back to the home page</a>
      </div>
    </div>
  </section>
</Base>
